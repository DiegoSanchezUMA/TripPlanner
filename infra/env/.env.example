# Copia este archivo a infra/env/.env y rellena los valores reales.
# infra/env/.env NUNCA se sube al repositorio (ver .gitignore en la raíz).
#
# Uso: desde infra/docker/
#   docker compose --env-file ../env/.env up -d
#
# Dos cosas importantes antes de rellenar esto (ver explicación completa en el chat):
#
# 1. "postgres", "redis" y "orchestrator" son nombres de SERVICIO de Docker Compose,
#    no "localhost". Todos los contenedores de un mismo compose comparten una red
#    interna con DNS propio: dentro de esa red, cada contenedor se alcanza por su
#    nombre de servicio. "localhost" dentro de un contenedor es el propio contenedor,
#    nunca otro. Es el error número uno al empezar con Docker.
#
# 2. Este .env es solo para LOCAL y para la VM de producción. El frontend en Vercel
#    NO lee este archivo: sus variables se definen en el panel de Vercel. Ahí, la URL
#    del backend va como BACKEND_URL (sin prefijo NEXT_PUBLIC_), porque solo la usa
#    el CopilotRuntime en el servidor de Next.js. Con NEXT_PUBLIC_ quedaría incrustada
#    en el JavaScript que se descarga el navegador — visible para cualquiera.

# --- PostgreSQL ---
POSTGRES_USER=tripplanner
POSTGRES_PASSWORD=changeme_usa_un_secreto_real
POSTGRES_DB=tripplanner
POSTGRES_PORT=5432
# Debe reconstruirse a mano si cambias usuario/contraseña/db de arriba: Compose no
# interpola una variable de .env dentro de otra variable de .env.
# Host = "postgres" (nombre del servicio en docker-compose.yml), no "db" ni "localhost".
DATABASE_URL=postgresql+psycopg://tripplanner:changeme_usa_un_secreto_real@postgres:5432/tripplanner

# --- Redis (caché de resultados MCP + cola del worker ConversiónFacts) ---
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- Comunicación interna entre procesos del backend ---
# El servicio "orchestrator" no se publica al host (solo "expose", no "ports"):
# nadie fuera de la red de Compose puede invocarlo saltándose la API (que es donde
# van el JWT y la comprobación de cuota).
ORCHESTRATOR_URL=http://orchestrator:8001
# Genera uno real con: openssl rand -hex 32
JWT_SECRET=

# --- LLMs (capas gratuitas — ver docs/arquitectura-multiagente-crewai.md §4) ---
GROQ_API_KEY=
GEMINI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=

# --- Herramientas externas / servidores MCP ---
# Un único servidor MCP para Places & Routes (Google Maps): el diagrama de
# despliegue original mostraba "Places MCP" y "Bus MCP" como dos cajas separadas,
# pero ambas son el mismo paquete (@mcp/server-google-maps) — un agente, un
# servidor MCP (ver docs/arquitectura-multiagente-crewai.md §1). Pendiente
# corregir también en docs/uml/despliegue/Deployment Diagram.jpg.
GOOGLE_MAPS_API_KEY=
MCP_FLIGHT_URL=
MCP_HOTEL_URL=
MCP_PLACES_URL=
MCP_WEATHER_URL=

# --- Observabilidad ---
# Langfuse Cloud (capa gratuita), no autoalojado: la versión self-hosted necesita
# su propia Postgres + ClickHouse + almacenamiento S3-compatible, demasiado para
# los 12 GB de la VM compartidos con el resto del stack.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
